<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Verify.SourceGenerators" />
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" />
    <PackageReference Include="Basic.Reference.Assemblies.Net90" />
    <PackageReference Include="Basic.Reference.Assemblies.Net80" />
    <PackageReference Include="Splat" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Splat.DependencyInjection.SourceGenerator\Splat.DependencyInjection.SourceGenerator.csproj" />
    <!-- Referenced (aliased) so the *Fail tests can run the analyzers that report the SPLATDI
         diagnostics. The alias avoids CS0433 since the analyzer assembly link-compiles
         DiagnosticWarnings.cs, which also lives in the generator assembly. -->
    <ProjectReference Include="..\..\Splat.DependencyInjection.Analyzer\Splat.DependencyInjection.Analyzer.csproj" Aliases="analyzer" />
  </ItemGroup>
</Project>
